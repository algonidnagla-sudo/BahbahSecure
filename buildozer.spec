[app]
title = Bahbah Secure
package.name = bahbahscan
package.domain = com.security.antivirus
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 1.0
requirements = python3,kivy,requests,certifi,urllib3,idna,charset-normalizer
android.permissions = INTERNET, READ_EXTERNAL_STORAGE, WRITE_EXTERNAL_STORAGE, RECORD_AUDIO, CAMERA, MANAGE_EXTERNAL_STORAGE, FOREGROUND_SERVICE
orientation = portrait
fullscreen = 1
android.arch = armeabi-v7a
p4a.branch = master
